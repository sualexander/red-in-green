# Unreal Engine generated — all regenerated by the editor, never commit
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/

# Same, for platform-specific subfolders
Platforms/*/Binaries/
Platforms/*/Build/
Platforms/*/Intermediate/

# Plugin-local generated folders
Plugins/**/Binaries/
Plugins/**/Intermediate/

# Packaged builds
Builds/
Packaged/

