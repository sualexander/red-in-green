.vs/
.idea/
.vscode/
*.sln
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
*.xcodeproj
*.xcworkspace

# Compiled binaries
*.dll
*.exe
*.lib
*.pdb
*.so
*.dylib
*.app

# DCC application autosaves / backups
*.blend1
*.blend2
*.autosave
Adobe After Effects Auto-Save/

# OS cruft
.DS_Store
Thumbs.db
desktop.ini
